{
  "firestore": {
    "rules": "firestore.rules",
    "indexes": "firestore.indexes.json"
  },
  "flutter": {
    "platforms": {
      "android": {
        "default": {
          "projectId": "licenta-df25e",
          "appId": "1:placeholder:android:placeholder",
          "fileOutput": "android/app/google-services.json"
        }
      },
      "dart": {
        "lib/firebase_options.dart": {
          "projectId": "licenta-df25e",
          "configurations": {
            "android": "1:placeholder:android:placeholder",
            "ios": "1:placeholder:ios:placeholder",
            "macos": "1:placeholder:ios:placeholder",
            "web": "1:placeholder:web:placeholder",
            "windows": "1:placeholder:web:placeholder"
          }
        }
      }
    }
  },
  "hosting": {
    "source": ".",
